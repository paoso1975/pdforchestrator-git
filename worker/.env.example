PDFORCH_API_BASE_URL=http://localhost:3000/api/internal/worker
WORKER_SHARED_SECRET=replace-with-the-same-random-secret-as-next
WORKER_ID=local-worker-1
WORKER_VERSION=1.0.0
WORKER_HEARTBEAT_SECONDS=30
WORKER_CONCURRENCY=1
WORKER_LEASE_SECONDS=180
WORKER_POLL_SECONDS=3
WORKER_JOB_TIMEOUT_SECONDS=3600
WORKER_MAX_PDF_BYTES=104857600
WORKER_MAX_PAGES=1000
GHOSTSCRIPT_BIN=gs
VERAPDF_BIN=verapdf
PDFA_ICC_PROFILE=/etc/pdf-orchestrator/srgb.icc
WORKER_TEMP_ROOT=
WORKER_TEMP_RETENTION_HOURS=24

CUBBIT_S3_ENDPOINT=https://s3.cubbit.eu
CUBBIT_S3_REGION=eu-west-1
CUBBIT_S3_BUCKET=YOUR_BUCKET
CUBBIT_S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
CUBBIT_S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# Optional native tools used by OCR, QR and barcode tools. These binaries are installed only on the external worker host.
POPPLER_BIN=
TESSERACT_CMD=tesseract
TESSERACT_LANGUAGES=eng,ita
OCR_PAGE_TIMEOUT_SECONDS=120
OMP_THREAD_LIMIT=1
