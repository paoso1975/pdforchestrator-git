# Neon pooled PostgreSQL connection for serverless runtime (include sslmode=require).
DATABASE_URL="postgresql://USER:PASSWORD@NEON_POOLER_HOST:PORT/DATABASE?sslmode=require"
# Direct PostgreSQL connection used only by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@NEON_DIRECT_HOST:PORT/DATABASE?sslmode=require"
# Maximum pg connections opened by one serverless invocation (tune to Neon plan limits).
DATABASE_POOL_MAX="3"


# Supabase project settings: Project Settings → API.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"
# Private server-only key. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
PUBLIC_API_URL="http://localhost:3000"

# Cubbit S3 identity used only by the Next.js server to sign upload/download URLs and check uploaded inputs.
# Use a separate service-account key for the external worker (worker/.env).
# Cubbit public S3 gateway; custom tenants use https://s3.<tenant>.cubbit.eu.
CUBBIT_S3_ENDPOINT="https://s3.cubbit.eu"
CUBBIT_S3_REGION="eu-west-1"
CUBBIT_S3_BUCKET="YOUR_BUCKET"
CUBBIT_S3_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
CUBBIT_S3_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"

# Requested S3_* names are also supported; when set they take precedence over CUBBIT_S3_*.
S3_ENDPOINT="https://s3.cubbit.eu"
S3_REGION="eu-west-1"
S3_BUCKET="YOUR_BUCKET"
S3_ACCESS_KEY_ID="YOUR_ACCESS_KEY_ID"
S3_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"
S3_FORCE_PATH_STYLE="true"

# Generate a separate 32-byte AES-256 key (openssl rand -base64 32).
# Keep server-only; never use a NEXT_PUBLIC_ variable.
PFO_CREDENTIAL_MASTER_KEY="REPLACE_WITH_32_RANDOM_BYTES_BASE64"
PFO_RATE_LIMIT_RPM="120"
PFO_JOB_LIMIT_RPM="30"
PFO_MAX_CONCURRENT_JOBS="10"
PFO_MAX_UPLOAD_BYTES="104857600"
PFO_ORG_STORAGE_QUOTA_BYTES="10737418240"
PFO_RETENTION_DAYS="30"

# Shared only by Next.js internal worker endpoints and the external worker host; generate 32+ random bytes.
WORKER_SHARED_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

